\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comparison on Diving48. Metrics are top-1 and top-5 accuracy (\%). The Input / views column preserves the notation used by each source: an explicit $frames\times clips\times crops$ value is shown when reported, while sources that report only the number of input frames retain a single frame-count value. Resolution-based configurations are also kept in their original form. Top-5 values are marked ``-'' where the source does not report them. ``$\dagger $'' marks the DSTS protocol \cite  {li2022dsts} and ``$\ddagger $'' the DVT protocol \cite  {dvt2022}; the two papers use different evaluation protocols, so values across the two groups are not directly comparable. The TDN row reports the corrected official result compiled in \cite  {chen2022aknet}, using the updated Diving48 annotations. The CAN row takes the $8$-frame ablation configuration from \cite  {li2025can}, whose main result uses $16$ frames; the AIM row reports the $8$-frame result reproduced by \cite  {cai2025loki}.}}{11}{table.1}\protected@file@percent }
\newlabel{tab:diving48}{{1}{11}{Comparison on Diving48. Metrics are top-1 and top-5 accuracy (\%). The Input / views column preserves the notation used by each source: an explicit $frames\times clips\times crops$ value is shown when reported, while sources that report only the number of input frames retain a single frame-count value. Resolution-based configurations are also kept in their original form. Top-5 values are marked ``-'' where the source does not report them. ``$\dagger $'' marks the DSTS protocol \cite {li2022dsts} and ``$\ddagger $'' the DVT protocol \cite {dvt2022}; the two papers use different evaluation protocols, so values across the two groups are not directly comparable. The TDN row reports the corrected official result compiled in \cite {chen2022aknet}, using the updated Diving48 annotations. The CAN row takes the $8$-frame ablation configuration from \cite {li2025can}, whose main result uses $16$ frames; the AIM row reports the $8$-frame result reproduced by \cite {cai2025loki}}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Comparison on Something-Something V2 with $8$ input frames and lightweight ResNet-50 backbones. Metrics are top-1 and top-5 accuracy (\%). TANet follows its original $8\times 1\times 1$ protocol \cite  {liu2021tam}; TDN and AK-Net follow the unified $8$-frame comparison in AK-Net Table II \cite  {chen2022aknet}; ILA, STAN-conv, and M2-CLIP follow their reported multi-view 8-frame settings \cite  {tu2023ila,liu2023stan,wang2024m2clip}. FEASE-Net, CAN, and MANet use their reported $8\times 1\times 1$ configurations \cite  {zhou2024fease,li2025can,li2025manet}. A dash denotes a top-5 value not reported by the source.}}{11}{table.2}\protected@file@percent }
\newlabel{tab:ssv2}{{2}{11}{Comparison on Something-Something V2 with $8$ input frames and lightweight ResNet-50 backbones. Metrics are top-1 and top-5 accuracy (\%). TANet follows its original $8\times 1\times 1$ protocol \cite {liu2021tam}; TDN and AK-Net follow the unified $8$-frame comparison in AK-Net Table II \cite {chen2022aknet}; ILA, STAN-conv, and M2-CLIP follow their reported multi-view 8-frame settings \cite {tu2023ila,liu2023stan,wang2024m2clip}. FEASE-Net, CAN, and MANet use their reported $8\times 1\times 1$ configurations \cite {zhou2024fease,li2025can,li2025manet}. A dash denotes a top-5 value not reported by the source}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Progressive ablation on Diving48 with $8\times 1\times 1$ views. Each row adds one component of DG-TDMto the previous configuration; the last column reports the top-1 gain over the preceding row. Metrics are top-1 and top-5 accuracy (\%).}}{12}{table.3}\protected@file@percent }
\newlabel{tab:ablation}{{3}{12}{Progressive ablation on Diving48 with $8\times 1\times 1$ views. Each row adds one component of \dgtdm to the previous configuration; the last column reports the top-1 gain over the preceding row. Metrics are top-1 and top-5 accuracy (\%)}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Design-choice ablation on Diving48 with $8\times 1\times 1$ views. Each row switches off one internal design choice of the full DG-TDMwhile keeping the affected component and the remaining configuration fixed. Metrics are top-1 and top-5 accuracy (\%).}}{12}{table.4}\protected@file@percent }
\newlabel{tab:design}{{4}{12}{Design-choice ablation on Diving48 with $8\times 1\times 1$ views. Each row switches off one internal design choice of the full \dgtdm while keeping the affected component and the remaining configuration fixed. Metrics are top-1 and top-5 accuracy (\%)}{table.4}{}}
